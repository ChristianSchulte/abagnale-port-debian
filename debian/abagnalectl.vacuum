#!/bin/sh
# Abagnale Algorithmic Trading System Database Maintenance

set -e
umask 0077

if ! getent passwd abagnale >/dev/null ||
	! getent passwd postgres >/dev/null; then
	exit 0
fi

ABAGNALE_BACKUPDIR=/var/lib/postgresql/abagnale/backups/$(date +%F)
ABAGNALE_CONFIGFILE=/etc/abagnale/abagnale.conf

if [ -f /etc/abagnale/abagnalectl.conf ]; then
	ABAGNALE_CONFIGFILE=/etc/abagnale/abagnalectl.conf
fi

runuser -u postgres -- sh -c '
	set -e
	umask 0027
	mkdir -p "$1"
	pg_dump --schema-only --create --schema=public ABAGNALE \
		> "$1/ABAGNALE-schema.sql"

	pg_dump --schema=public ABAGNALE \
		-t '\"STATISTICS\"' -t '\"TRADES\"' -t '\"IDENTIFIERS\"' \
		-t '\"TREND_STATES\"' \
			> "$1/ABAGNALE-data.sql"
' sh "$ABAGNALE_BACKUPDIR"

runuser -u abagnale -- abagnalectl -f "$ABAGNALE_CONFIGFILE" \
	vacuum -a -b "$ABAGNALE_BACKUPDIR"

runuser -u postgres -- sh -c '
	set -e
	umask 0027
	for file in "$1"/*;do
		if [ -f "$file" ]; then
			xz "$file"
			chmod 0640 "$file.xz"
		fi
	done
' sh "$ABAGNALE_BACKUPDIR"

exit 0
