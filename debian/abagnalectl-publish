#!/bin/sh
# Abagnale Algorithmic Trading System Publish Service
set -e

PLOTSDIR=/var/lib/abagnale/plots
PUBLISHDIR=/var/cache/abagnale/publish

if [ "$(id -un)" != "abagnale" ]; then
	echo "not user abagnale" >&2
	exit 1
fi

if ! command -v octave >/dev/null; then
	echo "no octave command" >&2
	exit 1
fi

if [ ! -d "$PLOTSDIR" ]; then
	exit 0
fi

if [ -z "$DISPLAY" ]; then
	if command -v Xvfb >/dev/null; then
		export DISPLAY=:0
		Xvfb >/dev/null 2>&1 &
		XVFB_PID=$!
		sleep 1
		trap "kill $XVFB_PID 2>/dev/null || true" EXIT
	fi
fi

mkdir -p "$PUBLISHDIR"

for m in "$PLOTSDIR"/bitvavo/trend/*.m "$PLOTSDIR"/coinbase/trend/*.m; do
	[ -f "$m" ] || continue
	rel="${m#$PLOTSDIR/}"
	svg="$PUBLISHDIR/${rel%.m}.svg"
	[ -f "$svg" ] && [ "$svg" -nt "$m" ] && continue
	mkdir -p "$(dirname "$svg")"
	(
		cd /tmp
		octave --quiet --no-gui --eval "\
			toolkits = available_graphics_toolkits();\
			if any(strcmp(toolkits, \"qt\"));\
				graphics_toolkit(\"qt\");\
			elseif any(strcmp(toolkits, \"fltk\"));\
				graphics_toolkit(\"fltk\");\
			endif;\
			set(0, 'defaultfigurevisible', 'off');\
			run(\"$m\");\
			print(\"-dsvg\", \"-svgconvert\", \"$svg\");\
		" >/dev/null 2>&1
	) || echo "Failure publishing $m"
done

exit 0
