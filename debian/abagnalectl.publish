#!/bin/sh
# Abagnale Algorithmic Trading System Publishing
set -e

UMASK=$(umask)
PLOTSDIR=/var/lib/abagnale/plots
PUBLISHDIR=/var/cache/abagnale/publish

if [ "$(id -un)" != "abagnale" ]; then
	echo "abagnalectl.publish must be run as user abagnale" >&2
	exit 1
fi

if ! command -v octave >/dev/null || [ ! -d "$PLOTSDIR" ]; then
	exit 0
fi

mkdir -p "$PUBLISHDIR"

for m in "$PLOTSDIR"/bitvavo/trend/*.m "$PLOTSDIR"/coinbase/trend/*.m; do
	[ -f "$m" ] || continue
	rel="${m#$PLOTSDIR/}"
	svg="$PUBLISHDIR/${rel%.m}.svg"
	[ -f "$svg" ] && [ "$svg" -nt "$m" ] && continue
	mkdir -p "$(dirname "$svg")"
	octave --quiet --no-gui --eval "\
		run(\"$m\"); \
		print(\"-dsvg\", \"$svg\"); \
	" >/dev/null 2>/dev/null || echo "Failure publishing $m"
done

exit 0
